{
  "name": "english-kaoyan-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node scripts/verify-english.mjs && node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "server": "node server.js",
    "start": "node scripts/launch.mjs --no-open",
    "start-all": "node scripts/launch.mjs",
    "setup-autostart": "./setup-autostart.sh",
    "create-shortcut": "./create-desktop-shortcut.sh",
    "test": "node --test tests/*.test.mjs",
    "check:english": "node scripts/verify-english.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
